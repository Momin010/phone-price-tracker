# Copy to .env and fill in. Leave the SUPABASE_* blank to run in local JSON mode.

# From Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Shared secret the dashboard must send as header  x-api-key.  Any random string.
API_KEY=
